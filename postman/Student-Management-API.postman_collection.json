{
  "info": {
    "_postman_id": "5f2d1a7c-8b3e-4c9a-9d61-2e7a4b8c1f30",
    "name": "Student Management API",
    "description": "Postman collection for the Student Management REST API. Start the Spring Boot application, select the 'Student Management API' collection, and run the requests in order. The collection stores the created student's ID automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "studentId",
      "value": "1"
    },
    {
      "key": "course",
      "value": "Computer Science"
    }
  ],
  "item": [
    {
      "name": "01 - Add Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response contains the created student\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property(\"id\");",
              "    pm.expect(body.name).to.eql(\"Aarav Sharma\");",
              "    pm.expect(body.email).to.eql(\"aarav.sharma@example.com\");",
              "    pm.collectionVariables.set(\"studentId\", body.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@example.com\",\n  \"course\": \"Computer Science\",\n  \"age\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    },
    {
      "name": "02 - Get All Students",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response is a non-empty array\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an(\"array\").that.is.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    },
    {
      "name": "03 - Get Student By ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Returns the requested student\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(String(body.id)).to.eql(String(pm.collectionVariables.get(\"studentId\")));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      }
    },
    {
      "name": "04 - Get Students By Course",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Every returned student is in the requested course\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an(\"array\");",
              "    body.forEach(function (student) {",
              "        pm.expect(student.course.toLowerCase()).to.eql(\"computer science\");",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/course/{{course}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "course",
            "{{course}}"
          ]
        }
      }
    },
    {
      "name": "05 - Update Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Student details are updated\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.course).to.eql(\"Information Technology\");",
              "    pm.expect(body.age).to.eql(21);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"email\": \"aarav.sharma@example.com\",\n  \"course\": \"Information Technology\",\n  \"age\": 21\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      }
    },
    {
      "name": "06 - Delete Student",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 204 No Content\", function () {",
              "    pm.response.to.have.status(204);",
              "});",
              "",
              "pm.test(\"Response body is empty\", function () {",
              "    pm.expect(pm.response.text()).to.eql(\"\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      }
    },
    {
      "name": "Optional - Error Handling",
      "item": [
        {
          "name": "07 - Get Deleted Student (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Error response has the expected shape\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"timestamp\");",
                  "    pm.expect(body).to.have.property(\"status\", 404);",
                  "    pm.expect(body.message).to.contain(\"Student not found\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/students/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students",
                "{{studentId}}"
              ]
            }
          }
        },
        {
          "name": "08 - Add Invalid Student (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Validation errors are returned\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"fieldErrors\");",
                  "    pm.expect(body.fieldErrors).to.have.property(\"email\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"course\": \"\",\n  \"age\": 0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "students"
              ]
            }
          }
        }
      ]
    }
  ]
}
